{
  "expo": {
    "name": "Timiza Logistics",
    "slug": "timiza-logistics",
    "scheme": "timiza-logistics",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/playstore.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/playstore.png",
      "resizeMode": "contain",
      "backgroundColor": "#2A7353"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.timizalogistics"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "##2A7353"
      },
      "package": "com.anonymous.timizalogistics"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "a59e3b51-b79c-42e3-97ab-df66cb2202c5"
      }
    }
  }
}
